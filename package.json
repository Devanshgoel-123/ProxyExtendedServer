{
  "name": "proxy-extended-server",
  "version": "1.0.0",
  "description": "Express server with TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "calc-positions": "tsx src/vesuDataService/runCalculation.ts",
    "calc-positions-loader": "node --loader ts-node/esm src/vesuDataService/runCalculation.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "node"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/client": "3.9.10",
    "@strkfarm/sdk": "file:../sdk-ts-1",
    "axios": "^1.13.4",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "fs": "^0.0.1-security"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
}
